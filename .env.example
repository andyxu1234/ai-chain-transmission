# AI 归因解读用的 LLM 凭证。复制为 .env 并填入真实值（.env 已被 gitignore）。
# 按以下优先级自动选择：deepseek > qwen > openai > siliconflow
# 任一 provider 的 KEY 存在即启用；都不存在时日报照常生成，只是没有 AI 解读段落。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备用 provider
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
